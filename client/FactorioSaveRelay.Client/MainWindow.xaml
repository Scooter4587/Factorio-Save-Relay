<Window x:Class="FactorioSaveRelay.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Factorio Save Relay — test app" Width="870" Height="790"
        MinWidth="720" MinHeight="600" WindowStartupLocation="CenterScreen" Background="#10151D">
    <Grid x:Name="RootGrid" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="FACTORIO SAVE RELAY" Foreground="#F2B441" FontWeight="Bold" FontSize="15" />
            <TextBlock Text="Manual test — select a copy outside Factorio's saves folder"
                       Margin="0,7,0,0" Foreground="#F4F7FA" FontSize="18" TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="1. Service and profile" Foreground="#F2B441" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Service address (HTTPS, or localhost for development)" Foreground="#DDE5ED" />
                        <TextBox x:Name="ServiceUrlBox" Text="http://127.0.0.1:8787" Margin="0,4,0,10" Padding="6" />
                        <TextBlock Text="Profile name — e.g. Adam or Friend" Foreground="#DDE5ED" />
                        <TextBox x:Name="ProfileBox" Text="Adam" Margin="0,4,0,10" Padding="6" />
                        <TextBlock Text="Device name" Foreground="#DDE5ED" />
                        <TextBox x:Name="DeviceNameBox" Text="My PC" Margin="0,4,0,10" Padding="6" />
                        <TextBlock Text="Registration key for hosted service (used only when registering)" Foreground="#DDE5ED" />
                        <PasswordBox x:Name="RegistrationKeyBox" Margin="0,4,0,10" Padding="6" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Register new profile" Click="RegisterClick" Padding="12,7" Margin="0,0,8,0" />
                            <Button Content="Load saved profile" Click="LoadProfileClick" Padding="12,7" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="2. Shared world" Foreground="#F2B441" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBox x:Name="WorldNameBox" Text="Test world" Width="230" Padding="6" Margin="0,0,8,0" />
                            <Button Content="Create world" Click="CreateWorldClick" Padding="12,7" Margin="0,0,8,0" />
                            <Button Content="Refresh worlds" Click="RefreshWorldsClick" Padding="12,7" />
                        </StackPanel>
                        <ComboBox x:Name="WorldCombo" SelectionChanged="WorldSelectionChanged" Margin="0,0,0,10" Padding="6" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Create invitation" Click="CreateInviteClick" Padding="12,7" Margin="0,0,8,0" />
                            <TextBox x:Name="InviteBox" Width="440" Padding="6" Margin="0,0,8,0" />
                            <Button Content="Join with code" Click="JoinWorldClick" Padding="12,7" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="3. Test save copy (.zip)" Foreground="#F2B441" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Selected ZIP copy — the real Factorio saves folder is blocked" Foreground="#DDE5ED" />
                        <DockPanel Margin="0,4,0,10">
                            <Button DockPanel.Dock="Right" Content="Choose ZIP / target" Click="ChooseSaveClick" Padding="12,7" Margin="8,0,0,0" />
                            <TextBox x:Name="SavePathBox" Padding="6" />
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Download latest safely" Click="SyncClick" Padding="12,7" Margin="0,0,8,0" />
                            <Button Content="Apply pending download" Click="ApplyPendingClick" Padding="12,7" Margin="0,0,8,0" />
                            <Button Content="Acquire host lease" Click="HostClick" Padding="12,7" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Upload selected ZIP" Click="UploadClick" Padding="12,7" Margin="0,0,8,0" />
                            <Button Content="Release host lease" Click="ReleaseClick" Padding="12,7" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="4. History" Foreground="#F2B441" Padding="12">
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="HistoryCombo" Width="350" Padding="6" Margin="0,0,8,0" />
                        <Button Content="Refresh history" Click="RefreshHistoryClick" Padding="12,7" Margin="0,0,8,0" />
                        <Button Content="Restore selected (owner)" Click="RestoreClick" Padding="12,7" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,14,0,0" Foreground="#DDE5ED"
                   Text="Start the local backend, then register or load a profile." TextWrapping="Wrap" />
    </Grid>
</Window>
