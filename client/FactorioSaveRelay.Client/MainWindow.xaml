<Window x:Class="FactorioSaveRelay.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Factorio Save Relay" Width="720" Height="680"
        MinWidth="620" MinHeight="560" WindowStartupLocation="CenterScreen" Background="#10151D">
    <Grid x:Name="RootGrid" Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock Text="FACTORIO SAVE RELAY" Foreground="#F2B441" FontWeight="Bold" FontSize="15" />
            <TextBlock Text="Jeden svet. Dvaja hostitelia." Margin="0,7,0,0"
                       Foreground="#F4F7FA" FontSize="26" FontWeight="SemiBold" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Border x:Name="LoginPanel" Background="#18212C" BorderBrush="#303D4C" BorderThickness="1"
                    CornerRadius="10" Padding="22" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="PRIHLÁSENIE" Foreground="#F2B441" FontWeight="Bold" />
                    <TextBlock Text="Účet a spoločný svet najprv vytvor na webe."
                               Foreground="#DDE5ED" Margin="0,8,0,20" />
                    <TextBlock Text="Meno účtu" Foreground="#DDE5ED" />
                    <TextBox x:Name="ProfileBox" Margin="0,5,0,13" Padding="9" />
                    <TextBlock Text="Heslo" Foreground="#DDE5ED" />
                    <PasswordBox x:Name="AccountPasswordBox" Margin="0,5,0,16" Padding="9" />
                    <WrapPanel>
                        <Button Content="Prihlásiť tento PC" Click="AccountLoginClick" Padding="15,9" Margin="0,0,9,0" />
                        <Button Content="Použiť uložené prihlásenie" Click="LoadProfileClick" Padding="15,9" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <ScrollViewer x:Name="DashboardPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right" Content="Odpojiť tento PC" Click="SignOutClick"
                                Padding="10,6" Background="#263343" Foreground="#DDE5ED" />
                        <StackPanel>
                            <TextBlock x:Name="WorldNameText" Text="Spoločný svet" Foreground="#F4F7FA"
                                       FontSize="25" FontWeight="SemiBold" />
                            <TextBlock x:Name="AccountText" Foreground="#9EADBC" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <Border Background="#18212C" BorderBrush="#303D4C" BorderThickness="1" CornerRadius="10" Padding="22">
                        <StackPanel>
                            <TextBlock Text="STAV" Foreground="#F2B441" FontWeight="Bold" />
                            <TextBlock x:Name="StateText" Text="Kontrolujem…" Foreground="#F4F7FA"
                                       FontSize="24" FontWeight="Bold" Margin="0,10,0,18" TextWrapping="Wrap" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Cloud" Foreground="#9EADBC" />
                                    <TextBlock x:Name="CloudRevisionText" Text="—" Foreground="#DDE5ED" FontSize="16" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Tento PC" Foreground="#9EADBC" />
                                    <TextBlock x:Name="LocalRevisionText" Text="—" Foreground="#DDE5ED" FontSize="16" />
                                </StackPanel>
                            </Grid>
                            <Separator Margin="0,18" Background="#303D4C" />
                            <TextBlock Text="Aktívny save vo Factoriu" Foreground="#9EADBC" />
                            <TextBlock x:Name="RelayFileText" Text="Zatiaľ nenastavený" Foreground="#DDE5ED"
                                       FontSize="16" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="HostText" Text="Hostiteľ: —" Foreground="#DDE5ED" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>

                    <WrapPanel Margin="0,18,0,0">
                        <Button x:Name="SetupButton" Content="Vytvoriť RELAY save" Click="SetupClick"
                                Padding="15,10" Margin="0,0,9,9" />
                        <Button x:Name="SyncButton" Content="Synchronizovať" Click="SyncClick"
                                Padding="15,10" Margin="0,0,9,9" />
                        <Button x:Name="TakeOverButton" Content="Prevziať hostovanie" Click="TakeOverClick"
                                Padding="15,10" Margin="0,0,9,9" />
                        <Button x:Name="ReleaseButton" Content="Uložiť a odovzdať" Click="ReleaseClick"
                                Padding="15,10" Margin="0,0,9,9" />
                        <Button Content="Obnoviť stav" Click="RefreshClick" Padding="15,10" Margin="0,0,9,9"
                                Background="#263343" Foreground="#DDE5ED" />
                    </WrapPanel>

                    <TextBlock Text="Poradie: synchronizovať → prevziať hostovanie → hrať a uložiť → zavrieť Factorio → odovzdať."
                               Foreground="#9EADBC" Margin="0,12,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="#18212C" CornerRadius="8" Padding="13" Margin="0,18,0,0">
            <TextBlock x:Name="StatusText" Foreground="#DDE5ED" Text="Prihlás sa účtom vytvoreným na webe."
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
